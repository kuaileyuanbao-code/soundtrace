+def __getattr__(name):
+    # AED-only clients do not need the full VAD/LID/punctuation system.
+    # Keep the two existing public system exports available on demand.
+    if name in {"FireRedAsr2System", "FireRedAsr2SystemConfig"}:
+        from fireredasr2s.fireredasr2system import (
+            FireRedAsr2System, FireRedAsr2SystemConfig
+        )
+        globals().update(FireRedAsr2System=FireRedAsr2System,
+                         FireRedAsr2SystemConfig=FireRedAsr2SystemConfig)
+        return globals()[name]
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
 
 
